# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/

# Debugging and export results (loose JSON/CSV dumps, local manifests)
*.csv
*.json

# Synthetic test fixtures are the one place JSON is committed.
!tests/fixtures/
!tests/fixtures/**/
!tests/fixtures/**/*.json

# Statements (never commit real PDFs)
*.pdf

# Claude
.claude/

# Codex
.codex
.codex/
